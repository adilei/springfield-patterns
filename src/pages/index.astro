---
import { analogies } from '../data/analogies';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Three Simpsons analogies for software design, customer dynamics, and AI, with practical lessons and original black-and-white illustrations." />
    <title>Springfield Patterns</title>
  </head>
  <body>
    <a class="skip-link" href="#examples">Skip to examples</a>
    <header>
      <h1>Springfield Patterns</h1>
      <p>Simpsons analogies for software, companies, customers, and AI.</p>
      <nav aria-label="Examples">
        <ul>
          {analogies.map((analogy) => (
            <li><a href={`#${analogy.id}`}>{analogy.title}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="examples" tabindex="-1">
      {analogies.map((analogy) => (
        <article id={analogy.id} aria-labelledby={`${analogy.id}-title`}>
          <h2 id={`${analogy.id}-title`}>{analogy.title}</h2>
          <p class="topic">{analogy.topic}</p>
          <figure>
            <img src={analogy.image} alt={analogy.imageAlt} width="720" height="240" />
            <figcaption>Original analogy illustration, not an episode still.</figcaption>
          </figure>
          <p class="episode">
            <a href={analogy.episode.url}>{analogy.episode.title}</a>
            {' '}(season {analogy.episode.season}, episode {analogy.episode.number})
          </p>
          <p><strong>In Springfield.</strong> {analogy.scene}</p>
          <p><strong>At work.</strong> {analogy.parallel}</p>
          <p><strong>Try this.</strong> {analogy.takeaway}</p>
          <p class="boundary"><strong>Where it breaks.</strong> {analogy.boundary}</p>
        </article>
      ))}
    </main>
    <footer>
      <p>
        An unofficial, unaffiliated fan project. The Simpsons and its characters belong
        to their respective rights holders. All illustrations here are original
        conceptual drawings; no episode artwork is used.
      </p>
      <p>
        Episode links point to Wikisimpsons for titles, numbering, and plot references.
        The software and business interpretations are our own.
        <a href="https://github.com/adilei/springfield-patterns">Source &amp; contributions</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    font-family: system-ui, sans-serif;
    color: #000000;
    background: #ffffff;
    line-height: 1.65;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  body {
    max-width: 46rem;
    margin: 0;
    padding: 2.5rem 1.25rem;
    margin-inline-start: clamp(0rem, 6vw, 6rem);
  }
  h1, h2 { line-height: 1.2; text-wrap: balance; }
  h1 { font-size: 2rem; margin: 0 0 0.75rem; }
  h2 { font-size: 1.5rem; margin: 0 0 0.5rem; }
  p { margin: 0 0 1rem; }
  a { color: #000000; text-underline-offset: 0.18em; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 2px solid #000000; outline-offset: 4px; }
  nav { margin-block: 1.5rem 2.5rem; }
  nav ul { list-style: none; padding: 0; margin: 0; }
  nav li + li { margin-top: 0.5rem; }
  article {
    border-top: 1px solid #000000;
    padding-block: 1.75rem 2rem;
    scroll-margin-top: 1rem;
  }
  .topic, figcaption, .boundary, footer { color: #666666; }
  .topic { margin-bottom: 1.25rem; }
  figure { margin: 0 0 1.25rem; }
  img { display: block; width: 100%; height: auto; border: 1px solid #000000; }
  figcaption { font-size: 0.8rem; margin-top: 0.35rem; }
  .episode { font-size: 0.9rem; }
  .boundary { font-size: 0.9rem; margin-bottom: 0; }
  footer { border-top: 1px solid #000000; padding-top: 1.5rem; font-size: 0.8rem; }
  footer p:last-child { margin-bottom: 0; }
  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 1rem;
    padding: 0.5rem;
    background: #ffffff;
    transform: translateY(-200%);
  }
  .skip-link:focus { transform: none; }
  @media (max-width: 40rem) {
    body { margin-inline-start: 0; padding-block: 1.5rem; }
    h1 { font-size: 1.75rem; }
  }
</style>
